<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tokyo Night, same values as web/css/tokyo-night.css, so the native
         chrome (action bar, window background behind the WebView) doesn't
         flash a light frame around a dark page. -->
    <color name="bg">#1a1b26</color>
    <color name="bg_dark">#16161e</color>
    <color name="blue">#7aa2f7</color>

    <style name="AppTheme" parent="@android:style/Theme.Material">
        <item name="android:colorPrimary">@color/bg_dark</item>
        <item name="android:colorPrimaryDark">@color/bg_dark</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>
</resources>
